#!/usr/bin/env python3
"""Convenience launcher for the Conveyor UI server."""
import os
import shutil
import subprocess
import sys

REPO = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
UI_DIR = os.path.join(REPO, "ui")
INDEX = os.path.join(UI_DIR, "dist", "ui", "browser", "index.html")


def ensure_built():
    if os.path.isfile(INDEX):
        return
    npm = shutil.which("npm")
    if not npm:
        print(
            "conveyor-ui: UI not built and npm not found on PATH.\n"
            "conveyor-ui: install Node.js 18+, then: cd ui && npm install && npm run build",
            file=sys.stderr,
        )
        return
    print("conveyor-ui: first run, building the Angular app (this can take a minute)...")
    if not os.path.isdir(os.path.join(UI_DIR, "node_modules")):
        r = subprocess.run([npm, "install"], cwd=UI_DIR)
        if r.returncode != 0:
            print("conveyor-ui: npm install failed; run it manually in ui/", file=sys.stderr)
            return
    r = subprocess.run([npm, "run", "build"], cwd=UI_DIR)
    if r.returncode != 0:
        print("conveyor-ui: npm run build failed; run it manually in ui/", file=sys.stderr)
        return
    print("conveyor-ui: build complete.")


ensure_built()

env = os.environ.copy()
prior = env.get("PYTHONPATH", "")
env["PYTHONPATH"] = REPO + ((os.pathsep + prior) if prior else "")
os.execvpe(sys.executable, [sys.executable, "-m", "ui.server", *sys.argv[1:]], env)
