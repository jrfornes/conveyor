#!/usr/bin/env python3
"""Conveyor operator CLI (protocol §10, runbook §4–7).

conveyor init [<path>] | uninstall [--yes] [--bundle]
           | start | stop [--now] | task <name> [--delete]
           | status | log <role> [<task>] | resume <task> [--to <role>]
           | import --source manual|jira [--title ...]
           | import --refresh <id> | import --replace <id>
           | intake <id> [--improve] [--comments <file>] | intake config | intake jira
           | inbox list | inbox show <id>
           | inbox approve <id> [--name <task>] [--force] | inbox skip <id>
           | inbox attachments <id> [--select ids|none]
           | start-task <name> | approve <id> | reject <id>
           | role list | show <name> | new <name> [--from <other>] | delete <name>
                    | skills <name> [--set a,b,c]
           | workflow list | show <slug> | new <name> --roles a,b,c [--gate <role>]
                    | edit <slug> [...] | delete <slug> | activate <slug>
           | gate list | run <name> [--role <role>]
"""
import contextlib
import json
import os
import shutil
import signal
import subprocess
import sys
import time

if sys.version_info < (3, 10):
    print(f"conveyor requires Python 3.10+ (found {sys.version.split()[0]} at {sys.executable})",
          file=sys.stderr)
    sys.exit(1)

BIN = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(BIN, "..", "lib"))
from conveyor import (adapters, agent as agentlib, attachments, board, config, gates, handoff, inbox,  # noqa: E402
                      intake as intakelib, jira as jiralib, layout, presets, queue,
                      roles as roleslib, util)

RULE_FILES = ["constitution.md", "constitution/engineering.md", "constitution/workflow.md",
              "constitution/handoffs.md", "project.md"]
RULES_REL = ".cursor/rules/conveyor-role.mdc"   # git paths are always posix
GITIGNORE = [".worktrees/", ".conveyor/", RULES_REL, "tmp/"]
REPO = os.path.dirname(BIN)
SHIPPED = ["constitution.md", "constitution/engineering.md", "constitution/workflow.md",
           "constitution/handoffs.md", "roles/coder.md", "roles/reviewer.md",
           "roles/specifier.md", "conveyor.conf.example"]
TEMPLATED = ["project.md", "intake/ticket-reviewer.md", "intake/rubric.md"]


def root_dir():
    d = os.getcwd()
    while True:
        if os.path.isfile(os.path.join(d, "conveyor.conf")) and os.path.isdir(os.path.join(d, ".git")):
            return d
        parent = os.path.dirname(d)
        if parent == d:
            util.die("conveyor: no conveyor.conf in a git checkout at or above the current directory")
        d = parent


def setup():
    root = root_dir()
    try:
        cfg = config.load(root)
    except config.ConfigError as e:
        util.die(f"conveyor: conveyor.conf: {e}")
    return root, cfg, layout.Paths(root)


def install_hook(root):
    hooks = os.path.join(util.git(["rev-parse", "--path-format=absolute", "--git-common-dir"], root), "hooks")
    os.makedirs(hooks, exist_ok=True)
    shutil.copy(os.path.join(BIN, "hooks", "commit-msg"), os.path.join(hooks, "commit-msg"))
    os.chmod(os.path.join(hooks, "commit-msg"), 0o755)


NO_IDENTITY = ('git has no commit identity in {root}; set one and retry:\n'
               '  git config --global user.name "Your Name"\n'
               '  git config --global user.email "you@example.com"')


def commit_env():
    """Operator env for a git commit: never carry a role into the byline hook."""
    return {k: v for k, v in os.environ.items() if k != "CONVEYOR_ROLE"}


def git_identity(root, env=None):
    """Refuse before any write when git cannot name a committer (protocol §7.4)."""
    return subprocess.run(["git", "var", "GIT_COMMITTER_IDENT"], cwd=root,
                          env=env or commit_env(), capture_output=True).returncode == 0


def commit_file(root, rel, message, what, rollback=None):
    """Stage and commit rel as the operator, leaving nothing staged when it fails."""
    env = commit_env()
    if not git_identity(root, env):
        _rollback(root, rel, rollback)
        util.die(f"{what}: " + NO_IDENTITY.format(root=root))
    util.git(["add", "--", rel], root)
    r = subprocess.run(["git", "commit", "-q", "-m", message, "--", rel], cwd=root, env=env,
                       capture_output=True, text=True)
    if r.returncode != 0:
        _rollback(root, rel, rollback)
        detail = (r.stderr or r.stdout or "").strip()
        util.die(f"{what}: git commit failed ({r.returncode})" + (f"\n{detail}" if detail else ""))


def _rollback(root, rel, path):
    """Unstage rel (and drop the file we wrote) so the next attempt starts clean."""
    util.git(["reset", "-q", "--", rel], root, check=False)
    if path:
        with contextlib.suppress(OSError):
            os.remove(path)


def ensure_worktree(root, paths, role_name):
    wt = paths.worktree(role_name)
    if not os.path.exists(os.path.join(wt, ".git")):
        util.git(["worktree", "add", "--force", "-B", f"conveyor-{role_name}", wt, "HEAD"], root)
    os.makedirs(os.path.join(wt, "tmp"), exist_ok=True)
    os.makedirs(os.path.join(wt, ".cursor", "rules"), exist_ok=True)
    rules = "".join(util.read_text(os.path.join(root, f)) + "\n" for f in RULE_FILES)
    if role_name == config.INTAKE_ROLE:
        rubric = intakelib.read_rubric(root)
        if rubric.strip():
            rules += f"# Grading rubric ({intakelib.RUBRIC_REL})\n\n" + rubric.rstrip("\n") + "\n\n"
        rules += intakelib.GRADE_CONTRACT.rstrip("\n") + "\n\n"
        rules += (
            "Attachments for this ticket, if the operator selected any, are files under "
            "`tmp/attachments/`. Look at them when grading or improving. Video and audio "
            "are never downloaded; watch those in Jira.\n\n"
        )
        role_md = intakelib.prompt_path(root)
    else:
        role_md = os.path.join(root, "roles", f"{role_name}.md")
    try:
        skills_block = roleslib.inject_skills(root, wt, role_name)
    except roleslib.RoleError as e:
        util.die(f"conveyor start: {e}")
    util.atomic_write(os.path.join(wt, ".cursor", "rules", "conveyor-role.mdc"),
                      f"---\ndescription: Conveyor rules for role {role_name}\nalwaysApply: true\n---\n\n"
                      + rules + util.read_text(role_md) + skills_block)
    return wt


def enqueue_task(root, cfg, paths, name):
    """Board row + operator ready handoff for an already-written tasks/<name>.md."""
    if board.get(paths, name) is not None:
        util.die(f"conveyor: {name} already exists (lane {board.get(paths, name)['lane']})")
    rel = f"tasks/{name}.md"
    if not os.path.isfile(os.path.join(root, rel)):
        util.die(f"conveyor: missing {rel}")
    board.add(paths, name, cfg.names()[0])
    op = paths.role("operator")
    message = subprocess.run(["git", "log", "-1", "--format=%B", "HEAD"], cwd=root,
                             capture_output=True, text=True, check=True).stdout
    headers = {"to": cfg.names()[0], "task": name, "verdict": "ready", "type": "git_handoff",
               "id": f"operator-{queue.issue_seq(op):06d}", "from": "operator",
               "commit": util.git(["rev-parse", "--short=10", "HEAD"], root),
               "task_id": board.get(paths, name)["task_id"], "created_at": util.now()}
    queue.install(op, headers, message.rstrip("\n") + "\n")
    queue.sweep(paths, cfg, "operator")
    return headers


loop_pid = layout.loop_pid


def clear_park(paths, task):
    """Remove needs-human/<task>/ and whatever is left in it. True if it existed."""
    d = os.path.join(paths.needs_human, task)
    if not os.path.isdir(d):
        return False
    for f in os.listdir(d):
        os.remove(os.path.join(d, f))
    os.rmdir(d)
    return True


# --- init ---------------------------------------------------------------
def cmd_init(args):
    target = os.path.realpath(args[0] if args and not args[0].startswith("--") else ".")
    if not util.git_ok(["rev-parse", "--is-inside-work-tree"], target):
        util.die(f"conveyor init: {target} is not a git checkout; run git init there first")
    os.makedirs(os.path.join(target, "tasks"), exist_ok=True)
    try:
        intakelib.migrate(target)
    except intakelib.IntakeError as e:
        util.die(f"conveyor init: {e}")
    for rel in SHIPPED:
        src, dst = os.path.join(REPO, rel), os.path.join(target, rel)
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        shutil.copy(src, dst)
    for rel in TEMPLATED:
        dst = os.path.join(target, rel)
        if not os.path.exists(dst):
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            shutil.copy(os.path.join(REPO, rel), dst)
    conf = os.path.join(target, "conveyor.conf")
    if not os.path.exists(conf):
        shutil.copy(os.path.join(target, "conveyor.conf.example"), conf)
        print("wrote conveyor.conf from the example; edit in the two model names before `conveyor start`")
    gi = os.path.join(target, ".gitignore")
    have = util.read_text(gi).splitlines() if os.path.exists(gi) else []
    missing = [e for e in GITIGNORE if e not in have]
    if missing:
        with open(gi, "a") as f:
            f.write(("" if not have or have[-1] == "" else "\n") + "\n".join(missing) + "\n")
    print(f"Conveyor bundle installed in {target}")
    print("Next: edit project.md and conveyor.conf, review `git status`, commit, then `conveyor start`.")


UNINSTALL_USAGE = "usage: conveyor uninstall [--yes] [--bundle]"


def uninstall_root():
    """Consumer project root; works when conveyor.conf is already gone."""
    d = os.getcwd()
    while True:
        if os.path.isdir(os.path.join(d, ".git")):
            if (os.path.isfile(os.path.join(d, "conveyor.conf"))
                    or os.path.isdir(os.path.join(d, ".conveyor"))
                    or os.path.isdir(os.path.join(d, ".worktrees"))):
                return d
        parent = os.path.dirname(d)
        if parent == d:
            util.die("conveyor uninstall: no conveyor project at or above the current directory")
        d = parent


def _conveyor_branches(root):
    r = subprocess.run(["git", "branch", "--list", "conveyor-*"], cwd=root,
                       capture_output=True, text=True)
    out = []
    for line in r.stdout.splitlines():
        branch = line.strip().lstrip("* ").strip()
        if branch.startswith("conveyor-"):
            out.append(branch)
    return sorted(out)


def _uninstall_role_names(paths, cfg=None):
    names = set(cfg.names()) if cfg else set()
    roles_dir = os.path.join(paths.conveyor, "roles")
    if os.path.isdir(roles_dir):
        names.update(os.listdir(roles_dir))
    return sorted(names)


def _stop_all_loops(root, paths, cfg=None):
    roles = _uninstall_role_names(paths, cfg)
    for role in roles:
        rp = paths.role(role)
        if os.path.isdir(rp.base):
            open(rp.stop, "w").close()
        pid = layout.loop_pid(paths, role)
        if pid:
            os.kill(pid, signal.SIGTERM)
    deadline = time.time() + 30
    while time.time() < deadline and any(layout.loop_pid(paths, r) for r in roles):
        time.sleep(0.2)
    for role in roles:
        rp = paths.role(role)
        if os.path.exists(rp.stop):
            os.remove(rp.stop)


def _remove_all_worktrees(root, paths):
    live = _git_worktrees(root)
    if not os.path.isdir(paths.worktrees):
        return []
    removed = []
    for name in sorted(os.listdir(paths.worktrees)):
        wt = paths.worktree(name)
        wt_real = os.path.realpath(wt)
        if wt_real in live or os.path.isdir(wt):
            if util.git_ok(["worktree", "remove", "--force", wt], root):
                removed.append(os.path.relpath(wt, root))
            elif os.path.isdir(wt):
                shutil.rmtree(wt)
                removed.append(os.path.relpath(wt, root))
    if os.path.isdir(paths.worktrees):
        shutil.rmtree(paths.worktrees)
        removed.append(".worktrees")
    return removed


def _remove_conveyor_hook(root):
    hooks = os.path.join(util.git(["rev-parse", "--path-format=absolute", "--git-common-dir"], root),
                         "hooks")
    hook_path = os.path.join(hooks, "commit-msg")
    if not os.path.isfile(hook_path):
        return None
    canonical = util.read_text(os.path.join(BIN, "hooks", "commit-msg"))
    if util.read_text(hook_path) == canonical:
        return ".git/hooks/commit-msg"
    return "warning: .git/hooks/commit-msg differs from Conveyor's; left in place"


def _bundle_removals(root):
    out = []
    for rel in SHIPPED:
        if os.path.isfile(os.path.join(root, rel)):
            out.append(rel)
    roles_dir = os.path.join(root, "roles")
    if os.path.isdir(roles_dir):
        extra = [f for f in os.listdir(roles_dir) if not f.endswith((".md", ".skills"))]
        for f in sorted(os.listdir(roles_dir)):
            if f.endswith((".md", ".skills")):
                out.append(f"roles/{f}")
        if not extra:
            out.append("roles/")
    for rel in TEMPLATED:
        if os.path.isfile(os.path.join(root, rel)):
            out.append(rel)
    intake_dir = os.path.join(root, "intake")
    if os.path.isdir(intake_dir):
        templated = {os.path.basename(r) for r in TEMPLATED if r.startswith("intake/")}
        if set(os.listdir(intake_dir)).issubset(templated):
            out.append("intake/")
    const_dir = os.path.join(root, "constitution")
    if os.path.isdir(const_dir):
        shipped_const = {os.path.basename(r) for r in SHIPPED if r.startswith("constitution/")}
        if set(os.listdir(const_dir)).issubset(shipped_const):
            out.append("constitution/")
    if os.path.isdir(os.path.join(root, "tasks")):
        out.append("tasks/")
    if os.path.isfile(os.path.join(root, "conveyor.conf")):
        out.append("conveyor.conf")
    gi = os.path.join(root, ".gitignore")
    if os.path.isfile(gi) and any(e in util.read_text(gi).splitlines() for e in GITIGNORE):
        out.append(".gitignore (Conveyor entries)")
    return out


def _remove_bundle(root):
    removed = []
    for rel in SHIPPED:
        path = os.path.join(root, rel)
        if os.path.isfile(path):
            os.remove(path)
            removed.append(rel)
    roles_dir = os.path.join(root, "roles")
    if os.path.isdir(roles_dir):
        for f in sorted(os.listdir(roles_dir)):
            if f.endswith((".md", ".skills")):
                os.remove(os.path.join(roles_dir, f))
                removed.append(f"roles/{f}")
        try:
            os.rmdir(roles_dir)
            removed.append("roles/")
        except OSError:
            pass
    for rel in TEMPLATED:
        path = os.path.join(root, rel)
        if os.path.isfile(path):
            os.remove(path)
            removed.append(rel)
    intake_dir = os.path.join(root, "intake")
    if os.path.isdir(intake_dir):
        try:
            os.rmdir(intake_dir)
            removed.append("intake/")
        except OSError:
            pass
    const_dir = os.path.join(root, "constitution")
    if os.path.isdir(const_dir):
        try:
            os.rmdir(const_dir)
            removed.append("constitution/")
        except OSError:
            pass
    tasks_dir = os.path.join(root, "tasks")
    if os.path.isdir(tasks_dir):
        shutil.rmtree(tasks_dir)
        removed.append("tasks/")
    conf = os.path.join(root, "conveyor.conf")
    if os.path.isfile(conf):
        os.remove(conf)
        removed.append("conveyor.conf")
    gi = os.path.join(root, ".gitignore")
    if os.path.isfile(gi):
        lines = util.read_text(gi).splitlines()
        kept = [l for l in lines if l not in GITIGNORE]
        if kept != lines:
            util.atomic_write(gi, ("\n".join(kept) + "\n") if kept else "")
            removed.append(".gitignore (Conveyor entries)")
    return removed


def _uninstall_plan(root, paths, bundle, cfg=None):
    plan = []
    if any(layout.loop_pid(paths, r) for r in _uninstall_role_names(paths, cfg)):
        plan.append("stop running loops (--now)")
    if os.path.isdir(paths.worktrees):
        for name in sorted(os.listdir(paths.worktrees)):
            plan.append(os.path.relpath(paths.worktree(name), root))
        plan.append(".worktrees")
    for branch in _conveyor_branches(root):
        plan.append(f"branch {branch}")
    if os.path.isdir(paths.conveyor):
        plan.append(".conveyor")
    hook = _remove_conveyor_hook(root)
    if hook:
        plan.append(hook)
    if bundle:
        plan.extend(_bundle_removals(root))
    return plan


def cmd_uninstall(args):
    if args and args[0] in ("-h", "--help"):
        util.die(UNINSTALL_USAGE)
    bundle = "--bundle" in args
    yes = "--yes" in args
    extra = [a for a in args if a not in ("--yes", "--bundle")]
    if extra:
        util.die(UNINSTALL_USAGE)
    repo_real = os.path.realpath(REPO)
    if os.path.realpath(os.getcwd()) == repo_real:
        util.die("conveyor uninstall: refusing to run in the conveyor source checkout")
    root = uninstall_root()
    if os.path.realpath(root) == repo_real:
        util.die("conveyor uninstall: refusing to run in the conveyor source checkout")
    paths = layout.Paths(root)
    cfg = None
    if os.path.isfile(os.path.join(root, "conveyor.conf")):
        try:
            cfg = config.load(root)
        except config.ConfigError:
            pass
    plan = _uninstall_plan(root, paths, bundle, cfg)
    if not yes:
        print("conveyor uninstall: dry run; pass --yes to proceed")
        if not plan:
            print("  (nothing to remove)")
        for line in plan:
            print(f"  would remove {line}")
        util.die("")
    if any(layout.loop_pid(paths, r) for r in _uninstall_role_names(paths, cfg)):
        _stop_all_loops(root, paths, cfg)
    for rel in _remove_all_worktrees(root, paths):
        print(f"removed {rel}")
    for branch in _conveyor_branches(root):
        if util.git_ok(["branch", "-D", branch], root):
            print(f"deleted branch {branch}")
    if os.path.isdir(paths.conveyor):
        shutil.rmtree(paths.conveyor)
        print("removed .conveyor")
    hook = _remove_conveyor_hook(root)
    if hook and not hook.startswith("warning"):
        hooks = os.path.join(util.git(["rev-parse", "--path-format=absolute", "--git-common-dir"], root),
                             "hooks")
        os.remove(os.path.join(hooks, "commit-msg"))
        print(f"removed {hook}")
    elif hook:
        print(hook)
    if bundle:
        for rel in _remove_bundle(root):
            print(f"removed {rel}")
    print("uninstalled")


# --- start / stop -----------------------------------------------------------
def _git_worktrees(root):
    """{realpath: branch-ref} from `git worktree list --porcelain` stanzas."""
    out = {}
    r = subprocess.run(["git", "worktree", "list", "--porcelain"],
                       cwd=root, capture_output=True, text=True)
    if r.returncode != 0:
        return out
    for stanza in r.stdout.split("\n\n"):
        wt, branch = "", ""
        for line in stanza.splitlines():
            if line.startswith("worktree "):
                wt = line[len("worktree "):].strip()
            elif line.startswith("branch "):
                branch = line[len("branch "):].strip()
        if wt:
            out[os.path.realpath(wt)] = branch
    return out


def prune_stale_worktrees(root, cfg, paths):
    """Remove .worktrees/<role> for roles the active workflow no longer configures.

    `git worktree remove` deletes the working directory and git's admin files
    only; the conveyor-<role> branch is untouched (branch deletion is `git
    branch -d/-D`, which we never run). Without --force git refuses on a dirty
    worktree, so uncommitted work degrades to a warning instead of being lost.

    Note the branch is only durable until the role comes back: ensure_worktree
    recreates with `-B`, which would reset conveyor-<role> to HEAD.
    """
    if not os.path.isdir(paths.worktrees):
        return
    live = _git_worktrees(root)
    keep = set(cfg.names()) | {config.INTAKE_ROLE}  # intake is never in cfg.names()
    for name in sorted(os.listdir(paths.worktrees)):
        if name in keep:
            continue
        wt = paths.worktree(name)
        # Only touch what git calls a worktree on this role's own branch, so a
        # directory a human parked under .worktrees/ is never removed.
        if live.get(os.path.realpath(wt)) != f"refs/heads/conveyor-{name}":
            continue
        if layout.loop_pid(paths, name):
            print(f"warning: {name} left the workflow but its loop is still running; "
                  f"run `conveyor stop` before starting again")
            continue
        if util.git_ok(["worktree", "remove", wt], root):
            print(f"removed stale worktree .worktrees/{name} "
                  f"(branch conveyor-{name} kept)")
        else:
            print(f"warning: .worktrees/{name} has uncommitted changes; remove it "
                  f"with: git worktree remove --force .worktrees/{name}")


def validate_project_gates(root, cfg):
    try:
        catalog = gates.read_catalog(root)
    except gates.GateParseError as e:
        util.die(f"conveyor start: project.md: {e}")
    for role, verdict, name in gates.validate_for_belt(catalog, cfg.names()):
        util.die(f"conveyor start: project.md lists unknown gate {name!r} "
                 f"for {role} {verdict}")


TRACKED_RULES = (
    "conveyor start: {rel} is tracked in git on {refs}.\n"
    "conveyor start regenerates that file per role, so a commit carrying one role's copy "
    "overwrites another role's instructions on merge -- the reviewer would run under the "
    "coder's rules.\n"
    "Untrack it on each branch listed, then re-run:\n"
    "  git rm --cached {rel} && git commit -m 'Untrack conveyor role rules file'"
)


def check_ignores(root, cfg):
    """The role worktrees check out the *committed* .gitignore, so that -- not the
    integration tree's working copy -- decides what an agent can commit. Reading the
    working copy would pass an entry `conveyor init` appended but nobody committed,
    which is exactly how a generated rules file reaches a commit."""
    committed = util.git(["show", "HEAD:.gitignore"], root, check=False).splitlines()
    for entry in GITIGNORE:
        if entry not in committed:
            print(f"warning: committed .gitignore lacks {entry} (add it and commit; the role "
                  f"worktrees only see what is committed)")
    refs = [r for r in ["HEAD", *(f"conveyor-{r.name}" for r in cfg.roles)]
            if util.git(["ls-tree", "-r", "--name-only", r, "--", RULES_REL], root, check=False)]
    if refs:
        util.die(TRACKED_RULES.format(rel=RULES_REL, refs=", ".join(refs)))


def cmd_start(args):
    root, cfg, paths = setup()
    agent = os.environ.get("CONVEYOR_AGENT_BIN", cfg.agent_bin)
    for r in cfg.roles:
        if not os.path.isfile(os.path.join(root, "roles", f"{r.name}.md")):
            util.die(f"conveyor start: roles/{r.name}.md is missing")
    validate_project_gates(root, cfg)
    if not git_identity(root):
        util.die("conveyor start: " + NO_IDENTITY.format(root=root))
    try:
        listed = agentlib.list_models(agent)
    except agentlib.AgentError as e:
        util.die(f"conveyor start: {e}")
    models = {m["id"] for m in listed}
    for role in cfg.roles:
        if role.model not in models:
            util.die(f"conveyor start: unknown model {role.model!r} for role {role.name}; "
                     f"choose one of: {', '.join(sorted(models))}")
    if cfg.agent_version:
        v = subprocess.run([agent, "--version"], capture_output=True, text=True).stdout.strip()
        if cfg.agent_version not in v:
            print(f"warning: agent version {v!r} differs from configured {cfg.agent_version!r}")
    check_ignores(root, cfg)
    paths.ensure(cfg)
    presets.ensure_seeded(paths)
    install_hook(root)
    prune_stale_worktrees(root, cfg, paths)
    for role in cfg.roles:
        wt = ensure_worktree(root, paths, role.name)
        rp = paths.role(role.name)
        if os.path.exists(rp.stop):
            os.remove(rp.stop)
        if "--no-smoke" not in args:
            env = {**os.environ, "CONVEYOR_ROLE": role.name, "CONVEYOR_WORKTREE": wt, "CONVEYOR_ROOT": root}
            s = subprocess.run([agent, "-p", "--force", "--model", role.model, *cfg.agent_args,
                                "reply with the word ok"], cwd=wt, capture_output=True, text=True, env=env)
            if s.returncode != 0:
                util.die(f"conveyor start: smoke test failed in {wt}: {s.stderr.strip() or s.stdout.strip()}")
    for role in cfg.roles:
        if loop_pid(paths, role.name):
            print(f"{role.name}: loop already running (pid {loop_pid(paths, role.name)})")
            continue
        env = {**os.environ, "CONVEYOR_ROLE": role.name, "CONVEYOR_WORKTREE": paths.worktree(role.name),
               "CONVEYOR_ROOT": root, "CONVEYOR_AGENT_BIN": agent}
        out = open(os.path.join(paths.logs, role.name, "loop.log"), "a")
        p = subprocess.Popen([os.path.join(BIN, "role-loop.sh")], cwd=root, env=env,
                             stdout=out, stderr=subprocess.STDOUT, start_new_session=True)
        print(f"{role.name}: loop started (pid {p.pid})")


def cmd_stop(args):
    _, cfg, paths = setup()
    for role in cfg.roles:
        open(paths.role(role.name).stop, "w").close()
        pid = loop_pid(paths, role.name)
        if pid and "--now" in args:
            os.kill(pid, signal.SIGTERM)
    while any(loop_pid(paths, r.name) for r in cfg.roles):
        time.sleep(0.2)
    for role in cfg.roles:  # no loop was running: sentinel would be stale
        rp = paths.role(role.name)
        if os.path.exists(rp.stop):
            os.remove(rp.stop)
    print("stopped")


# --- task -------------------------------------------------------------------
def cmd_task(args):
    root, cfg, paths = setup()
    paths.ensure(cfg)
    names = [a for a in args if not a.startswith("--")]
    if len(names) != 1 or not handoff.TASK_RE.match(names[0]):
        util.die("usage: conveyor task <name> [--delete]   (name: ^[a-z0-9][a-z0-9.-]*$)")
    name = names[0]
    row = board.get(paths, name)
    if "--delete" in args:
        if row is None:
            util.die(f"conveyor task: no board row for {name}")
        if row["lane"] in cfg.names():
            util.die(f"conveyor task: {name} is in lane {row['lane']}; stop it or wait before deleting")
        board.delete(paths, name)
        for role in os.listdir(paths.roles):
            fp = os.path.join(paths.role(role).audit_pending, f"{name}.fp")
            if os.path.isfile(fp):
                os.remove(fp)
        parked = clear_park(paths, name)  # the row and the park entry die together
        return print(f"deleted board row for {name}"
                     + (" and its needs-human entry" if parked else ""))
    if row is not None:
        util.die(f"conveyor task: {name} already exists (lane {row['lane']})")
    if sys.stdin.isatty():
        path = os.path.join(root, "tasks", f"{name}.md")
        os.makedirs(os.path.dirname(path), exist_ok=True)
        open(path, "a").close()
        subprocess.run([*os.environ.get("EDITOR", "vi").split(), path], check=True)
        text = util.read_text(path)
    else:
        text = sys.stdin.read()
    if not text.strip():
        util.die("conveyor task: empty task text")
    rel = f"tasks/{name}.md"
    os.makedirs(os.path.join(root, "tasks"), exist_ok=True)
    util.atomic_write(os.path.join(root, rel), text)
    util.git(["add", "--", rel], root)
    if util.git(["status", "--porcelain", "--", rel], root):
        commit_file(root, rel, f"Add task {name}", "conveyor task")
    headers = enqueue_task(root, cfg, paths, name)
    print(f"{headers['id']} queued for {headers['to']}")


# --- status / log / resume --------------------------------------------------
def cmd_status(args):
    _, cfg, paths = setup()
    for role in cfg.roles:
        rp = paths.role(role.name)
        items = layout.handoffs(rp.in_process)
        done = layout.handoffs(rp.completed)
        last = f"last: {handoff.read(os.path.join(rp.completed, done[-1]))[0]['task']}" if done else "last: -"
        if items:
            h = handoff.read(os.path.join(rp.in_process, items[0]))[0]
            age = util.age_seconds(h["dequeued_at"]) // 60 if "dequeued_at" in h else 0
            state = (f"in_process: {h['task']} ({h['id']})  age {age}m   "
                     f"attempt {h.get('attempt', 1)}/{role.max_attempts}")
        else:
            state = "idle"
        print(f"{role.name:<10} {state:<50} new: {len(layout.handoffs(rp.new))}  {last}")
    print("needs-human:")
    for p in sorted(queue.parked_items(paths)):
        task = os.path.basename(os.path.dirname(p))
        lines = util.read_text(os.path.join(os.path.dirname(p), "reason")).split("\n")
        print(f"  {task:<12}{lines[0]:<14}{lines[1] if len(lines) > 1 else ''}")
    print("board:")
    for r in board.read(paths):
        print(f"  {r['name']:<12}{r['lane']:<13}audit {r['audit_count']}  retry {r['retry_count']}")
    _print_inbox_block(paths)


# Items past the operator's decision; listed as a count, not a row.
INBOX_TERMINAL = ("started", "skipped")


def _print_inbox_block(paths):
    """`inbox:` section of `conveyor status`, omitted when there is no inbox.

    A repo that never ran `conveyor import` prints exactly what runbook §6
    shows, so the M4 status-format assertion keeps holding.
    """
    items = inbox.list_items(paths)
    if not items:
        return
    print("inbox:")
    done = {k: 0 for k in INBOX_TERMINAL}
    for it in items:
        if it["status"] in done:
            done[it["status"]] += 1
            continue
        print(f"  {it['id']:<12}{it['status']:<19}{it['grade']}")
    tail = ", ".join(f"{n} {k}" for k, n in done.items() if n)
    if tail:
        print(f"  ({tail})")


# Keys worth showing per event, in reading order; `event`/`error` are conveyor's own.
LOG_DETAIL_KEYS = ("event", "subtype", "name", "command", "text", "output",
                   "result", "error", "exit")


def cmd_log(args):
    _, cfg, paths = setup()
    if not args or args[0] not in cfg.names():
        util.die("usage: conveyor log <role> [<task>]")
    d = os.path.join(paths.logs, args[0])
    prefix = f"{args[1]}_" if len(args) > 1 else ""
    logs = sorted((os.path.getmtime(os.path.join(d, f)), f) for f in os.listdir(d)
                  if f.endswith(".jsonl") and f.startswith(prefix)) if os.path.isdir(d) else []
    if not logs:
        util.die("no log found")
    rows = []
    for line in util.read_text(os.path.join(d, logs[-1][1])).splitlines():
        try:
            ev = json.loads(line)
        except ValueError:
            rows.append(("", None, line))
            continue
        kind = ev.get("type", "?")
        detail = " ".join(str(ev[k]) for k in LOG_DETAIL_KEYS if k in ev and ev[k] not in ("", None))
        if kind in ("assistant", "result", "tool", "tool_call", "tool_result", "conveyor") or detail:
            rows.append((str(ev.get("at", "")), kind, detail[:400]))
    started = next((at for at, _, _ in rows if at), "")
    print(f"== {logs[-1][1]}{'  ' + started if started else ''}")
    for at, kind, detail in rows:
        # Times are UTC, as everywhere else in conveyor; the header carries the date.
        clock = f"{at[11:19]:<9}" if len(at) == 20 else " " * 9
        text = detail if kind is None else f"[{kind}] {detail}"
        print(clock + text.replace("\n", "\n" + " " * 9))  # wrapped output stays in its column


def cmd_resume(args):
    _, cfg, paths = setup()
    if not args:
        util.die("usage: conveyor resume <task> [--to <role>]")
    task = args[0]
    d = os.path.join(paths.needs_human, task)
    item = os.path.join(d, "item.handoff")
    if not os.path.exists(item):
        util.die(f"conveyor resume: {task} is not parked")
    if board.get(paths, task) is None:  # refuse before the rename; never half-resume
        util.die(f"conveyor resume: {task} is parked but has no board row; "
                 f"remove {os.path.join('.conveyor', 'needs-human', task)}/ to discard it")
    h = handoff.stamp(item, attempt=1)
    to = args[args.index("--to") + 1] if "--to" in args else h["to"]
    if to == "done":
        dest, lane = paths.role(h["from"]).outbox, h["from"]
    elif to in cfg.names():
        dest, lane = paths.role(to).new, to
    else:
        util.die(f"conveyor resume: unknown role {to}")
    os.rename(item, os.path.join(dest, handoff.filename(h)))
    board.update(paths, task, lane=lane)
    clear_park(paths, task)
    print(f"{task} resumed to {to}" + (" (delivered by the next sweep)" if to == "done" else ""))


# --- import / intake / inbox ------------------------------------------------
def _flag(args, name, default=None):
    if name in args:
        i = args.index(name)
        if i + 1 < len(args) and not args[i + 1].startswith("--"):
            return args[i + 1]
    return default


def _positionals(args):
    skip = set()
    for flag in ("--name", "--title", "--source", "--comments",
                 "--roles", "--gate", "--description", "--set", "--from",
                 "--refresh", "--replace", "--select"):
        if flag in args:
            i = args.index(flag)
            skip.add(i)
            if i + 1 < len(args):
                skip.add(i + 1)
    return [a for i, a in enumerate(args) if i not in skip and not a.startswith("--")]


IMPORT_USAGE = (
    "usage: conveyor import --source manual|jira [--title ...]\n"
    "       conveyor import --refresh <id>\n"
    "       conveyor import --replace <id>"
)


def _require_imported(meta, iid, verb):
    status = meta.get("status") or "imported"
    if status != "imported":
        util.die(f"conveyor import: {iid} is {status}; "
                 f"--{verb} only applies to imported items")


def _empty_jira_notice(iid):
    print(f"notice: {iid} has an empty Jira description; "
          f"grade skipped until you add a body.")


def _attachment_notices(iid, rows, url, spec_empty):
    n_av = attachments.video_audio_count(rows)
    if n_av:
        watch = url if url and url != "-" else "Jira"
        print(f"notice: {iid} has {n_av} video/audio attachments that were not "
              f"downloaded; watch them in Jira: {watch}")
    if spec_empty and not rows:
        _empty_jira_notice(iid)


def _import_refresh(paths, cfg, iid):
    try:
        meta = inbox.read_meta(paths, iid)
    except inbox.InboxError as e:
        util.die(f"conveyor import: {e}")
    _require_imported(meta, iid, "refresh")
    if meta.get("source") != "jira":
        util.die(f"conveyor import: {iid} is source {meta.get('source') or '-'}; "
                 f"--refresh requires a Jira item")
    external_id = meta.get("external_id") or "-"
    if external_id in ("", "-"):
        util.die(f"conveyor import: {iid} has no external_id; "
                 f"--refresh requires a Jira issue key")
    try:
        tickets = adapters.fetch("jira", external_id, cfg=cfg, paths=paths)
    except ValueError as e:
        util.die(f"conveyor import: {e}")
    t = tickets[0]
    err = t.get("error")
    if err:
        line = f"failed {t.get('external_id') or external_id}  {err['status']} {err['message']}"
        print(line)
        util.die(line)
    url = t.get("url") or meta.get("url") or ""
    rows = attachments.install(
        paths, iid, t.get("attachments") or [], t.get("body") or "", url,
        keep_selection=True)
    inbox.update_meta(paths, iid, title=t["title"], url=t.get("url") or "-")
    print(f"refreshed {iid}  {t['title']}")
    _attachment_notices(iid, rows, url, not (t.get("body") or "").strip())


def _import_replace(paths, iid, raw):
    try:
        meta = inbox.read_meta(paths, iid)
    except inbox.InboxError as e:
        util.die(f"conveyor import: {e}")
    _require_imported(meta, iid, "replace")
    inbox.write_file(paths, iid, "source.md", raw)
    attachments.rewrite_footer(paths, iid)
    print(f"replaced {iid}")


def cmd_import(args):
    root, cfg, paths = setup()
    paths.ensure(cfg)
    has_refresh = "--refresh" in args
    has_replace = "--replace" in args
    refresh_id = _flag(args, "--refresh")
    replace_id = _flag(args, "--replace")
    extras = _positionals(args)
    if has_refresh and has_replace:
        util.die(IMPORT_USAGE)
    raw = sys.stdin.read() if not sys.stdin.isatty() else ""
    if has_refresh:
        if not refresh_id or extras or raw.strip():
            util.die(IMPORT_USAGE)
        return _import_refresh(paths, cfg, refresh_id)
    if has_replace:
        if not replace_id or extras:
            util.die(IMPORT_USAGE)
        if not raw.strip():
            util.die("conveyor import: empty replacement text")
        return _import_replace(paths, replace_id, raw)
    source = _flag(args, "--source", "manual")
    title = _flag(args, "--title", "")
    try:
        tickets = adapters.fetch(source, raw, cfg=cfg, title=title, paths=paths)
    except ValueError as e:
        util.die(f"conveyor import: {e}")
    created = []
    for t in tickets:
        err = t.get("error")
        if err:
            key = t.get("external_id") or "?"
            print(f"failed {key}  {err['status']} {err['message']}")
            continue
        preferred = (t.get("external_id") or "").lower().replace("_", "-")
        spec = t.get("body") or ""
        rows = attachments.rows_from(t.get("attachments") or [])
        iid = inbox.create(paths, {
            "id": preferred,
            "source": t["source"],
            "title": t["title"],
            "url": t.get("url") or "-",
            "external_id": t.get("external_id") or "-",
            "status": "imported",
        }, attachments.apply_footer(spec, rows, t.get("url") or ""))
        if rows:
            attachments.write(paths, iid, rows)
        created.append(iid)
        print(f"imported {iid}  {t['title']}")
        if source == "jira" and preferred and iid != preferred and inbox.exists(paths, preferred):
            print(f"notice: {preferred} exists; created {iid}. "
                  f"To update the original: conveyor import --refresh {preferred}")
        if source == "jira":
            _attachment_notices(iid, rows, t.get("url") or "", not spec.strip())
    if not created:
        util.die("conveyor import: nothing imported")


def cmd_intake_config(args):
    root, cfg, _paths = setup()
    model = _flag(args, "--model")
    minutes = _flag(args, "--minutes")
    attempts = _flag(args, "--attempts")
    if model is None and minutes is None and attempts is None:
        tr = cfg.role(config.INTAKE_ROLE)
        print(f"model {tr.model}")
        print(f"max_minutes {tr.max_minutes}")
        print(f"max_attempts {tr.max_attempts}")
        return
    updates = {}
    if model is not None:
        updates["ticket_reviewer_model"] = model
    if minutes is not None:
        updates["ticket_reviewer_max_minutes"] = minutes
    if attempts is not None:
        updates["ticket_reviewer_max_attempts"] = attempts
    try:
        config.write_inbox(root, updates)
        cfg = config.load(root)
    except config.ConfigError as e:
        util.die(f"conveyor intake config: {e}")
    tr = cfg.role(config.INTAKE_ROLE)
    print(f"wrote [inbox] model={tr.model} max_minutes={tr.max_minutes} max_attempts={tr.max_attempts}")


def cmd_intake_jira(args):
    root, cfg, paths = setup()
    if "--clear" in args:
        jiralib.clear(paths)
        print("cleared .conveyor/local/jira.json")
        return
    site = _flag(args, "--site")
    email = _flag(args, "--email")
    token = None
    if "--token-stdin" in args:
        token = sys.stdin.read()
        if token.endswith("\n"):
            token = token[:-1]
    if site is not None or email is not None or token is not None:
        existing = jiralib.read(paths)
        try:
            jiralib.write(
                paths,
                existing["site"] if site is None else site,
                existing["email"] if email is None else email,
                existing["token"] if not token else token,
            )
        except ValueError as e:
            util.die(f"conveyor intake jira: {e}")
        print("wrote .conveyor/local/jira.json")
    if "--test" in args:
        result = jiralib.check(paths, cfg)
        print(f"{'ok' if result['ok'] else 'failed'} {result['status']} {result['message']}")
        return
    if site is None and email is None and token is None:
        r = jiralib.redact(jiralib.read(paths))
        print(f"site {r['site'] or '-'}")
        print(f"email {r['email'] or '-'}")
        print(f"token_set {r['token_set']}")


INTAKE_USAGE = (
    "usage: conveyor intake <id> [--improve] [--comments <file-or-text>]\n"
    "       conveyor intake config | conveyor intake jira"
)


def _refuse_committed(meta, iid):
    """Refuse to re-grade an item whose task file is already committed.

    `grading` / `improving` stay re-runnable: the loop-lock preflight covers a
    live run, and a status left behind by a crashed one must not strand the
    item. `skipped` stays re-gradable too — un-skipping is ordinary.
    """
    status = meta.get("status") or "imported"
    task = meta.get("task_name") or iid
    if status == "ready":
        util.die(f"conveyor intake: {iid} is ready; tasks/{task}.md is already committed")
    if status == "started":
        util.die(f"conveyor intake: {iid} is started; its task is already in the pipeline")


def cmd_intake(args):
    if args and args[0] == "config":
        return cmd_intake_config(args[1:])
    if args and args[0] == "jira":
        return cmd_intake_jira(args[1:])
    root, cfg, paths = setup()
    names = _positionals(args)
    if len(names) != 1:
        util.die(INTAKE_USAGE)
    iid = names[0]
    improve = "--improve" in args
    try:
        meta = inbox.read_meta(paths, iid)
    except inbox.InboxError as e:
        util.die(f"conveyor intake: {e}")
    _refuse_committed(meta, iid)
    comments = _flag(args, "--comments")
    if comments:
        inbox.write_file(paths, iid, "comments.txt", util.read_text(comments) if os.path.isfile(comments) else comments)
    role_md = intakelib.prompt_path(root)
    if not os.path.isfile(role_md):
        util.die(f"conveyor intake: missing {role_md}")
    paths.ensure(cfg, extra_roles=(config.INTAKE_ROLE,))
    # Preflight: the ticket-reviewer loop lock is shared across every inbox
    # item, so a second grade/improve while one is in flight can't run yet.
    # Caught here, before the item is marked busy, so it stays clickable.
    busy_pid = layout.loop_pid(paths, config.INTAKE_ROLE)
    if busy_pid:
        util.die(f"conveyor intake: ticket-reviewer is busy (pid {busy_pid}) grading or "
                 f"improving another item; wait for it to finish, then retry {iid}")
    inbox.update_meta(paths, iid, status="improving" if improve else "grading")
    try:
        install_hook(root)
        wt = ensure_worktree(root, paths, config.INTAKE_ROLE)
        # One-shot: start from current main so leftover grade.md cannot conflict.
        util.git(["reset", "--hard", util.git(["rev-parse", "HEAD"], root)], wt)
        # The reset prunes tmp/ when a previous run tracked it (a repo whose
        # init files, .gitignore included, are not committed yet).
        os.makedirs(os.path.join(wt, "tmp"), exist_ok=True)
        src = inbox.read_file(paths, iid, "source.md")
        util.atomic_write(os.path.join(wt, "tmp", "source.md"), src if src.endswith("\n") else src + "\n")
        att_dest = os.path.join(wt, "tmp", "attachments")
        if os.path.isdir(att_dest):
            shutil.rmtree(att_dest)
        attachments.download_selected(paths, cfg, iid, att_dest)
        rp = paths.role(config.INTAKE_ROLE)
        if os.path.exists(rp.stop):
            os.remove(rp.stop)
        queued = False
        for d in (rp.new, rp.in_process):
            for f in layout.handoffs(d):
                try:
                    if handoff.read(os.path.join(d, f))[0].get("task") == iid:
                        queued = True
                except (handoff.ParseError, OSError):
                    pass
        if not queued:
            op = paths.role("operator")
            commit = util.git(["rev-parse", "--short=10", "HEAD"], root)
            mode = "improve" if improve else "grade"
            headers = {"to": config.INTAKE_ROLE, "task": iid, "verdict": "ready", "type": "git_handoff",
                       "id": f"operator-{queue.issue_seq(op):06d}", "from": "operator",
                       "commit": commit, "task_id": f"intake-{iid}", "created_at": util.now(),
                       "enqueued_at": util.now()}
            body = f"mode: {mode}\n\n{src}"
            tmp = os.path.join(rp.inbox_tmp, handoff.filename(headers))
            handoff.write(tmp, headers, body if body.endswith("\n") else body + "\n")
            os.rename(tmp, os.path.join(rp.new, handoff.filename(headers)))
        agent = os.environ.get("CONVEYOR_AGENT_BIN", cfg.agent_bin)
        env = {**os.environ, "CONVEYOR_ROLE": config.INTAKE_ROLE, "CONVEYOR_WORKTREE": wt,
               "CONVEYOR_ROOT": root, "CONVEYOR_AGENT_BIN": agent}
        os.makedirs(os.path.join(paths.logs, config.INTAKE_ROLE), exist_ok=True)
        r = subprocess.run([os.path.join(BIN, "role-loop.sh"), "--once"], cwd=root, env=env,
                           capture_output=True, text=True)
    except attachments.AttachmentsError as e:
        inbox.update_meta(paths, iid, status="imported")
        util.die(f"conveyor intake: {e}")
    except Exception:
        # Never leave the item stuck in grading/improving: whatever failed,
        # the operator must be able to see and re-click it.
        inbox.update_meta(paths, iid, status="imported")
        raise
    park_dir = os.path.join(paths.needs_human, iid)
    if os.path.isdir(park_dir):
        reason = "parked"
        try:
            reason = util.read_text(os.path.join(park_dir, "reason")).split("\n")[0] or reason
        except OSError:
            pass
        clear_park(paths, iid)
        inbox.update_meta(paths, iid, status="imported")
        util.die(f"conveyor intake: parked ({reason}); {iid} reset to imported")
    if r.returncode != 0:
        inbox.update_meta(paths, iid, status="imported")
        util.die(f"conveyor intake: ticket-reviewer loop failed ({r.returncode}):\n{r.stdout}{r.stderr}")
    out = (r.stdout or "").strip()
    if out:
        print(out)
    _consume_comments(paths, iid)
    _report_grade(paths, iid, improve)


def _consume_comments(paths, iid):
    """Rename comments.txt → comments-applied.txt after a successful one-shot.

    A rename, not a delete: the text stays readable, and the next run's prompt
    (role-loop.sh build_intake_prompt) no longer picks up feedback the
    ticket-reviewer has already seen.
    """
    d = os.path.join(paths.inbox, iid)
    src = os.path.join(d, "comments.txt")
    if os.path.isfile(src) and util.read_text(src).strip():
        os.rename(src, os.path.join(d, "comments-applied.txt"))


def _report_grade(paths, iid, improve):
    """Print the recorded verdict, and say so when the grade file lacked one."""
    grade = inbox.read_meta(paths, iid)["grade"]
    print(f"{'improved' if improve else 'graded'} {iid}  {grade}")
    if grade == "unparsed":
        print(f'warning: {iid} grade.md has no "Grade: Ready|Gaps|Unusable" line; '
              "recorded as unparsed")


INBOX_USAGE = (
    "usage: conveyor inbox list | conveyor inbox show <id>\n"
    "       conveyor inbox approve <id> [--name <task>] [--force]\n"
    "       conveyor inbox skip <id>\n"
    "       conveyor inbox attachments <id> [--select ids|none]"
)
# Grades an approve will act on without --force. Everything else in
# inbox.GRADE_VALUES means the operator has nothing trustworthy to approve.
APPROVABLE = ("Ready", "Gaps")
# Documents shown by `conveyor inbox show`, in reading order.
SHOW_FILES = ("source.md", "grade.md", "proposed-task.md",
              "comments.txt", "comments-applied.txt")


def _inbox_list(paths):
    items = inbox.list_items(paths)
    if not items:
        return print("(no inbox items)")
    for it in items:
        print(f"{it['id']:<14}{it['source']:<8}{it['status']:<19}"
              f"{it['grade']:<11}{it['title']}")


def _inbox_show(paths, iid):
    meta = inbox.read_meta(paths, iid)
    print(f"id: {iid}")
    for k in inbox.META_KEYS:
        print(f"{k}: {meta[k]}")
    for name in SHOW_FILES:
        text = inbox.read_file(paths, iid, name)
        if text.strip():
            print(f"\n--- {name} ---\n{text.rstrip()}")


def _approve_guard(iid, grade, force):
    """Refuse an approve the grade does not support. `--force` overrides."""
    if force or grade in APPROVABLE:
        return
    tail = "or approve anyway with --force"
    if grade == "Unusable":
        util.die(f"conveyor inbox approve: {iid} is graded Unusable; "
                 f"fix the ticket and re-grade, {tail}")
    if grade == "unparsed":
        util.die(f'conveyor inbox approve: {iid} grade.md has no "Grade:" line; '
                 f"re-grade it, {tail}")
    util.die(f"conveyor inbox approve: {iid} has no grade; "
             f"run conveyor intake {iid} first, {tail}")


def cmd_inbox_attachments(args):
    names = _positionals(args)
    if len(names) != 1:
        util.die(INBOX_USAGE)
    iid = names[0]
    _, cfg, paths = setup()
    paths.ensure(cfg)
    if not inbox.exists(paths, iid):
        util.die(f"conveyor inbox: no inbox item {iid}")
    has_select = "--select" in args
    select_raw = _flag(args, "--select")
    if has_select and select_raw is None:
        util.die(INBOX_USAGE)
    try:
        if has_select:
            if select_raw.strip().lower() == "none":
                ids = []
            else:
                ids = [s.strip() for s in select_raw.split(",") if s.strip()]
            rows = attachments.select(paths, iid, ids)
        else:
            rows = attachments.read(paths, iid)
    except attachments.AttachmentsError as e:
        util.die(f"conveyor inbox: {e}")
    for row in rows:
        print(attachments.format_list_line(row))


def _own_debris(root, rel, body):
    """True when rel is a leftover from an approve that died before committing:
    byte-identical to what we would write now, and absent from HEAD."""
    try:
        if util.read_text(os.path.join(root, rel)) != body:
            return False
    except OSError:
        return False
    return not util.git_ok(["cat-file", "-e", f"HEAD:{rel}"], root)


def cmd_inbox(args):
    if not args or args[0] not in ("list", "show", "approve", "skip", "attachments"):
        util.die(INBOX_USAGE)
    if args[0] == "attachments":
        return cmd_inbox_attachments(args[1:])
    # list/show are pure reads (protocol §10): never create queue directories.
    if args[0] in ("list", "show"):
        _, _cfg, paths = setup()
        if args[0] == "list":
            if len(args) != 1:
                util.die(INBOX_USAGE)
            return _inbox_list(paths)
        if len(args) != 2:
            util.die("usage: conveyor inbox show <id>")
        try:
            return _inbox_show(paths, args[1])
        except inbox.InboxError as e:
            util.die(f"conveyor inbox: {e}")
    root, cfg, paths = setup()
    paths.ensure(cfg)
    if args[0] == "skip":
        if len(args) < 2:
            util.die("usage: conveyor inbox skip <id>")
        try:
            inbox.update_meta(paths, args[1], status="skipped")
        except inbox.InboxError as e:
            util.die(f"conveyor inbox: {e}")
        return print(f"skipped {args[1]}")
    names = _positionals(args[1:])
    if len(names) != 1:
        util.die("usage: conveyor inbox approve <id> [--name <task>] [--force]")
    iid = names[0]
    task = _flag(args, "--name") or iid
    if not handoff.TASK_RE.match(task):
        util.die(f"conveyor inbox approve: invalid task name {task!r}")
    try:
        item = inbox.item(paths, iid)
    except inbox.InboxError as e:
        util.die(f"conveyor inbox: {e}")
    _approve_guard(iid, item["grade"], "--force" in args)
    text = (item["proposed_md"] or attachments.strip_footer(item["source_md"])).strip()
    if not text:
        util.die("conveyor inbox approve: no proposed-task.md or source.md to write")
    rel = f"tasks/{task}.md"
    dest = os.path.join(root, rel)
    body = text + ("\n" if not text.endswith("\n") else "")
    if os.path.exists(dest) and not _own_debris(root, rel, body):
        hint = "approve under another name with --name <task>"
        if not util.git_ok(["cat-file", "-e", f"HEAD:{rel}"], root):
            hint = f"it is uncommitted and differs; remove it or {hint}"
        util.die(f"conveyor inbox approve: {rel} already exists ({hint})")
    os.makedirs(os.path.join(root, "tasks"), exist_ok=True)
    util.atomic_write(dest, body)
    commit_file(root, rel, f"Add task {task}", "conveyor inbox approve", rollback=dest)
    inbox.update_meta(paths, iid, status="ready", task_name=task)
    print(f"approved {iid} → {rel} (not enqueued; run conveyor start-task {task})")


def cmd_start_task(args):
    root, cfg, paths = setup()
    paths.ensure(cfg)
    if len(args) != 1 or not handoff.TASK_RE.match(args[0]):
        util.die("usage: conveyor start-task <name>")
    name = args[0]
    rel = f"tasks/{name}.md"
    if not os.path.isfile(os.path.join(root, rel)):
        util.die(f"conveyor start-task: missing {rel}")
    headers = enqueue_task(root, cfg, paths, name)
    for it in inbox.list_items(paths):
        if it.get("task_name") == name and it.get("status") == "ready":
            inbox.update_meta(paths, it["id"], status="started")
    print(f"{headers['id']} queued for {headers['to']}")


def cmd_approve(args):
    _, cfg, paths = setup()
    if len(args) != 1:
        util.die("usage: conveyor approve <id>")
    try:
        h = queue.approve_pending(paths, cfg, args[0])
    except KeyError:
        util.die(f"conveyor approve: no pending approval {args[0]}")
    print(f"approved {h['id']} → {h['to']}")


def cmd_reject(args):
    _, cfg, paths = setup()
    names = [a for a in args if not a.startswith("--")]
    if len(names) != 1:
        util.die("usage: conveyor reject <id> [--comments <file>]")
    comments_arg = _flag(args, "--comments")
    if comments_arg and os.path.isfile(comments_arg):
        comments = util.read_text(comments_arg)
    elif not sys.stdin.isatty():
        comments = sys.stdin.read()
    else:
        comments = comments_arg or ""
    if not comments.strip():
        util.die("conveyor reject: comments required (stdin or --comments <file>)")
    try:
        h = queue.reject_pending(paths, cfg, names[0], comments)
    except KeyError:
        util.die(f"conveyor reject: no pending approval {names[0]}")
    print(f"rejected {h['id']} → {h['to']}")


WORKFLOW_USAGE = """usage: conveyor workflow list | show <slug>
                | new <name> --roles a,b,c [--gate <role>] [--description <text>]
                | edit <slug> [--name <text>] [--roles a,b,c] [--gate <role>|--no-gate]
                         [--description <text>]
                | delete <slug> | activate <slug>"""


def _wf_roles(args):
    """--roles a,b,c -> ["a","b","c"]; None when the flag is absent."""
    raw = _flag(args, "--roles")
    if raw is None:
        return None
    return [r.strip() for r in raw.split(",") if r.strip()]


def _wf_status(paths, cfg, slug):
    active, status = presets.resolve(paths, cfg)
    if slug == active:
        return status          # "active" or "modified"
    return ""


def _wf_line(p, marker):
    gate = f"after {p['gate']}" if p["gate"] else "-"
    return f"  {p['slug']:<20}{p['name']:<20}{' → '.join(p['roles']):<34}{gate:<16}{marker}"


def cmd_workflow(args):
    if not args:
        util.die(WORKFLOW_USAGE)
    verb, rest = args[0], args[1:]
    root, cfg, paths = setup()
    presets.ensure_seeded(paths)
    names = _positionals(rest)

    def one_slug():
        if len(names) != 1:
            util.die(WORKFLOW_USAGE)
        return names[0]

    try:
        if verb == "list":
            active, _ = presets.resolve(paths, cfg)
            print(f"  {'SLUG':<20}{'NAME':<20}{'ROLES':<34}{'GATE':<16}STATUS")
            for p in presets.load_all(paths):
                print(_wf_line(p, _wf_status(paths, cfg, p["slug"])))
            if active is None:
                print(f"\n  conveyor.conf is a custom shape: {cfg.chain_label()}")
            return

        if verb == "show":
            slug = one_slug()
            p = presets.load(paths, slug)
            marker = _wf_status(paths, cfg, slug)
            print(f"{p['name']}  ({presets.rel_path(slug)})"
                  + (f"  [{marker}]" if marker else ""))
            if p["description"]:
                print(f"  {p['description']}")
            print(f"  roles: {' → '.join(p['roles'])}")
            print(f"  gate:  {p['gate'] or 'none'}")
            return

        if verb == "new":
            if len(names) != 1 or _wf_roles(rest) is None:
                util.die(WORKFLOW_USAGE)
            p = presets.create(root, paths, {
                "name": names[0],
                "description": _flag(rest, "--description", ""),
                "roles": _wf_roles(rest),
                "gate": _flag(rest, "--gate"),
            })
            return print(f"{presets.rel_path(p['slug'])} created")

        if verb == "edit":
            slug = one_slug()
            patch = {}
            if _flag(rest, "--name") is not None:
                patch["name"] = _flag(rest, "--name")
            if _flag(rest, "--description") is not None:
                patch["description"] = _flag(rest, "--description")
            if _wf_roles(rest) is not None:
                patch["roles"] = _wf_roles(rest)
            if "--no-gate" in rest:
                patch["gate"] = None
            elif _flag(rest, "--gate") is not None:
                patch["gate"] = _flag(rest, "--gate")
            if not patch:
                util.die("conveyor workflow edit: nothing to change")
            presets.save(root, paths, slug, patch)
            return print(f"{presets.rel_path(slug)} saved")

        if verb == "delete":
            slug = one_slug()
            presets.delete(paths, cfg, slug)
            return print(f"{presets.rel_path(slug)} deleted")

        if verb == "activate":
            slug = one_slug()
            r = presets.activate(root, paths, cfg, slug)
            p = r["preset"]
            print(f"conveyor.conf ← {slug} ({p['name']}): {' → '.join(p['roles'])}"
                  + (f", gate after {p['gate']}" if p["gate"] else ", no gate"))
            print(f".conveyor/active → {slug}. "
                  f"Restart loops: conveyor stop && conveyor start")
            for name in r["dropped"]:
                leftovers = [x for x in (paths.worktree(name), paths.role(name).base)
                             if os.path.exists(x)]
                if leftovers:
                    rels = ", ".join(os.path.relpath(x, root) for x in leftovers)
                    print(f"warning: {name} left the workflow; {rels} remain on disk "
                          f"(`conveyor start` prunes the worktree; the branch "
                          f"conveyor-{name} is untouched)")
            return
    except presets.PresetError as e:
        util.die(f"conveyor workflow {verb}: {e}")
    except FileNotFoundError as e:
        util.die(f"conveyor workflow {verb}: {e}")
    except RuntimeError as e:
        util.die(f"conveyor workflow {verb}: {e}")

    util.die(WORKFLOW_USAGE)


ROLE_USAGE = """usage: conveyor role list | show <name>
                | new <name> [--from <other>] | delete <name>
                | skills <name> [--set a,b,c]"""


def cmd_role(args):
    if not args:
        util.die(ROLE_USAGE)
    verb, rest = args[0], args[1:]
    root, cfg, paths = setup()
    names = _positionals(rest)

    def one_name():
        if len(names) != 1:
            util.die(ROLE_USAGE)
        return names[0]

    try:
        if verb == "list":
            belt = set(cfg.names())
            print(f"  {'NAME':<20}{'STATUS':<12}{'SKILLS'}")
            for name in roleslib.list_names(root):
                skills = ",".join(roleslib.assigned_skills(root, name)) or "-"
                status = "on belt" if name in belt else "library"
                print(f"  {name:<20}{status:<12}{skills}")
            return

        if verb == "show":
            name = one_name()
            path = roleslib.md_path(root, name)
            if not os.path.isfile(path):
                util.die(f"conveyor role show: unknown role {name!r}; create roles/{name}.md first")
            belt = "on belt" if name in cfg.names() else "library"
            skills = roleslib.assigned_skills(root, name)
            print(f"{path}  [{belt}]")
            print(f"  skills: {', '.join(skills) if skills else 'none'}")
            print()
            print(util.read_text(path), end="")
            return

        if verb == "new":
            if len(names) != 1:
                util.die(ROLE_USAGE)
            from_name = _flag(rest, "--from")
            roleslib.create(root, names[0], from_name=from_name)
            return print(f"roles/{names[0]}.md created")

        if verb == "delete":
            name = one_name()
            roleslib.delete(root, paths, cfg, name)
            return print(f"roles/{name}.md deleted")

        if verb == "skills":
            name = one_name()
            raw = _flag(rest, "--set")
            if raw is not None:
                skills = [s.strip() for s in raw.split(",") if s.strip()]
                roleslib.write_skills(root, name, skills)
                return print(f"roles/{name}.skills saved")
            assigned = roleslib.assigned_skills(root, name)
            avail = roleslib.available_skills(root)
            print(f"assigned: {', '.join(assigned) if assigned else 'none'}")
            if avail:
                print("available:")
                for s in avail:
                    desc = f" — {s['description']}" if s["description"] else ""
                    src = f" ({s['source']})" if s.get("source") else ""
                    print(f"  {s['name']}{desc}{src}")
            else:
                print("available: none (add .agents/skills/<name>/SKILL.md "
                      "or .cursor/skills/<name>/SKILL.md)")
            return
    except roleslib.RoleError as e:
        util.die(f"conveyor role {verb}: {e}")

    util.die(ROLE_USAGE)


GATE_USAGE = "usage: conveyor gate list | run <name> [--role <role>]"


def cmd_gate(args):
    if not args:
        util.die(GATE_USAGE)
    verb, rest = args[0], args[1:]
    root, cfg, paths = setup()
    try:
        catalog = gates.read_catalog(root)
    except gates.GateParseError as e:
        util.die(f"conveyor gate: project.md: {e}")

    if verb == "list":
        for name in sorted(catalog.commands):
            argv = catalog.commands[name]
            print(f"{name}\t{argv or '(empty)'}")
        return

    if verb == "run":
        if not rest or rest[0].startswith("-"):
            util.die(GATE_USAGE)
        name = rest[0]
        role = _flag(rest, "--role")
        wt = paths.worktree(role) if role else root
        if role and not os.path.isdir(wt):
            util.die(f"conveyor gate run: no worktree for role {role!r}; run conveyor start")
        try:
            catalog = gates.read_catalog(root, wt=wt)
        except gates.GateParseError as e:
            util.die(f"conveyor gate run: project.md: {e}")
        if name not in catalog.commands:
            util.die(f"conveyor gate run: unknown gate {name!r}")
        argv = catalog.commands[name]
        if not argv.strip():
            return print(f"{name}: skipped (empty command)")
        head = util.git(["rev-parse", "--short=10", "HEAD"], wt)
        inbound = head
        task = "manual"
        log_role = role or "operator"
        if role:
            items = layout.handoffs(paths.role(role).in_process)
            if len(items) == 1:
                inbound = handoff.read(os.path.join(paths.role(role).in_process, items[0]))[0]["commit"]
                task = handoff.read(os.path.join(paths.role(role).in_process, items[0]))[0]["task"]
        try:
            expanded = gates.expand(argv, inbound, head)
        except gates.GateSubstError as e:
            util.die(f"conveyor gate run: unknown placeholder {e.token}")
        try:
            gates.run(paths, wt, log_role, task, head, name, expanded)
        except gates.GateFailedError as e:
            util.die(f"conveyor gate run: exit {e.exit_code} (see {os.path.relpath(e.log_path, root)})")
        print(f"{name}: ok")
        return

    util.die(GATE_USAGE)


COMMANDS = {"init": cmd_init, "uninstall": cmd_uninstall, "start": cmd_start, "stop": cmd_stop,
            "task": cmd_task, "status": cmd_status, "log": cmd_log, "resume": cmd_resume,
            "import": cmd_import, "intake": cmd_intake, "inbox": cmd_inbox,
            "start-task": cmd_start_task, "approve": cmd_approve, "reject": cmd_reject,
            "role": cmd_role,
            "workflow": cmd_workflow, "gate": cmd_gate}

if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] not in COMMANDS:
        util.die(__doc__.strip())
    COMMANDS[sys.argv[1]](sys.argv[2:])
