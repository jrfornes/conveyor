# Conveyor pipeline configuration. One role per line, in pipeline order.
#
#   role <name> <model> [max_retries=N] [max_minutes=N] [max_attempts=N] [cli-args...]
#
# <model> is passed verbatim to `cursor-agent --model`. Run `cursor-agent --list-models`
# (or `cursor-agent models`) to see what your subscription exposes; `conveyor start`
# refuses unknown models.
# Effort is part of Cursor's model name (e.g. a -high suffix), not a flag.
#
# Pick models from different families for coder and reviewer so the second
# look is not correlated with the first. The names below are placeholders:
# replace them with two entries from `cursor-agent --list-models`.

role coder    composer-2.5  max_retries=3 max_minutes=120 max_attempts=3
role reviewer composer-2.5  max_minutes=60 max_attempts=2

# Optional human gate. `gate <role>` holds that role's outbound `ready` in
# .conveyor/approvals/pending/ until you run `conveyor approve <id>` (or
# `conveyor reject <id>`). The gated role must not be the last one.
# `gate none` says "no gate" outright — needed on a three-role belt, where an
# absent line still means "gate the first role" for backward compatibility.
#
#   gate specifier
#   gate none

# Optional integration policy: what `done` does with the reviewed commit.
# [global]
#   integration = merge            # default: merge into the integration tree's branch
#   integration = hold             # no merge; leave it on conveyor-<role> to merge/PR yourself
#   integration = command: python3 .conveyor/local/bitbucket-pr   # run a hook (e.g. open a PR)
#   integration_base = develop     # optional target branch a command hook sees as CONVEYOR_BASE
# A command hook gets CONVEYOR_ROOT/TASK/TASK_ID/COMMIT/BRANCH/BASE in its env; nonzero exit
# parks the task `done-command`. See bin/hooks/bitbucket-pr for a Bitbucket Cloud example.

# Optional intake ceilings. Jira credentials are not in this file — they
# live in gitignored .conveyor/local/jira.json (mode 600). Set them with
#   conveyor intake jira --site https://example.atlassian.net \
#     --email you@example.com --token-stdin
# or Inbox → Intake settings → Jira. Manual import works without any of this.
# [inbox]
# ticket_reviewer_model = composer-2.5
# ticket_reviewer_max_minutes = 30
# ticket_reviewer_max_attempts = 2
